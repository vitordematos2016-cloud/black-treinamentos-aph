# ==============================================================================
# APH TREINAMENTOS — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Cliente: Cleve (Bombeiro) | Hospedagem Alvo: Hostinger VPS 2
# ==============================================================================

# 1. APLICAÇÃO & HOSPEDAGEM (HOSTINGER VPS 2)
VITE_APP_NAME="APH Treinamentos"
VITE_APP_URL="http://localhost:5173"
VITE_ENVIRONMENT="development"

# 2. FONTE DA VERDADE — SUPABASE (PostgreSQL + Auth + Storage)
# Quando criar o projeto no Supabase, preencha as chaves abaixo:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 3. GATEWAY DE PAGAMENTOS ("MEIO CAMINHO ANDADO" — MERCADO PAGO & STRIPE)
# Opções de Provider: "MERCADO_PAGO" | "STRIPE"
# Opções de Modo: "SIMULATION" (funciona sem chaves para demonstração) | "PRODUCTION"
VITE_PAYMENT_PROVIDER="MERCADO_PAGO"
VITE_PAYMENT_MODE="SIMULATION"

# 3.1 Credenciais Mercado Pago (Pix, Cartão, Boleto)
VITE_MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# 3.2 Credenciais Stripe (Cartão, Boleto, Pix via Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
